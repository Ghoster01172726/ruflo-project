# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.claude-flow/daemon.pid
.claude-flow/daemon-state.json

# Local memory/vector/swarm databases (machine-specific, not portable)
.swarm/
.claude/memory.db
.claude/proven-config.json
.claude/.proven-config-version
ruvector.db
.serena/project.local.yml

# Tunnel deployment secrets (reality private key, uuid, short-id) — never commit
server/.secrets/

# Android build output / local toolchain state
android/libs/*.aar
android/local.properties
android/.gradle/
android/build/
android/*/build/

# Caches
.pytest_cache/

# Runtime metrics/policy state (constantly rewritten by hooks/agents)
.claude-flow/metrics/
.claude-flow/policy/
